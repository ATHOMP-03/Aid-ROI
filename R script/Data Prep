#Now to impute missing values

log_linear_impute = function(data, unit_col, time_col, value_col) {
  library(dplyr)
  library(zoo)
  library(rlang)
  
  unit_sym = sym(unit_col)
  time_sym = sym(time_col)
  value_sym = sym(value_col)
  
  data %>%
    filter(!is.na(!!unit_sym) & !!unit_sym != "") %>%   # 🚫 filter out blank country rows
    arrange(!!unit_sym, !!time_sym) %>%
    group_by(!!unit_sym) %>%
    mutate(
      log_val = log(!!value_sym),
      log_val = na.approx(log_val, x = !!time_sym, na.rm = FALSE),
      log_val = na.locf(log_val, na.rm = FALSE),
      log_val = na.locf(log_val, fromLast = TRUE, na.rm = FALSE),
      !!value_col := exp(log_val)
    ) %>%
    select(-log_val) %>%
    ungroup()
}

